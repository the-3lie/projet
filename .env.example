# ---------------------------------------------------------------------------
# Backend IUA — variables d'environnement
# En local : copier ce fichier en .env
# Sur Render : à saisir dans Environment (ne JAMAIS commiter .env)
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (Prisma Postgres, Neon, Supabase, Render Postgres…)
DATABASE_URL="postgresql://user:password@localhost:5432/presence_iua"

# Port d'écoute (Render le fournit automatiquement : ne pas le définir là-bas)
PORT=4000

# Secrets JWT — trois valeurs DIFFÉRENTES, longues et aléatoires.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-moi-par-une-longue-phrase-aleatoire"
JWT_SECRET_ETUDIANT="change-moi-aussi-etudiant-chef-de-classe"
JWT_ADMIN_SECRET="change-moi-aussi-par-une-autre-longue-phrase-aleatoire"

# CORS : origines autorisées (frontends Vercel + apps mobiles), séparées par des virgules.
# Le joker * est accepté. Laisser vide en local = tout autoriser.
# Exemple :
# CORS_ORIGINS="https://admin-iua.vercel.app,https://enseignant-iua.vercel.app,https://etudiant-iua.vercel.app,https://chef-iua.vercel.app,https://localhost,capacitor://localhost"
CORS_ORIGINS=""

# Utilisés uniquement par prisma/seed-admin.ts pour créer le premier compte admin
ADMIN_EMAIL="admin@iuaci.org"
ADMIN_PASSWORD="ChangeMoiVite2026!"
ADMIN_FIRSTNAME="Administrateur"
ADMIN_LASTNAME="Principal"
ESTABLISHMENT_NAME="Institut Universitaire d'Abidjan"
